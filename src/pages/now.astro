---
import PageShell from '../layouts/PageShell.astro';
import { QuickFacts } from '#components';
import { getNowEntries } from '#content';
import { renderMarkdown } from '#lib/content/markdown.ts';

const MONTH_NAMES = [
	'January',
	'February',
	'March',
	'April',
	'May',
	'June',
	'July',
	'August',
	'September',
	'October',
	'November',
	'December'
];

const entries = await Promise.all(
	getNowEntries().map(async (entry) => ({
		...entry,
		label: `${MONTH_NAMES[entry.month - 1]} ${entry.year}`,
		contentHtml: await renderMarkdown(entry.content)
	}))
);

const featured = entries.length > 0 ? entries[0] : null;
const archive = entries.slice(1);
---

<PageShell
	title="Now · Emma Campbell"
	description="What I'm up to, updated whenever something changes."
>
	<!-- Page header -->
	<div class="page-header-row">
		<div class="page-header-label">
			<span class="phl-key">last updated</span>
			<span class="phl-val">{featured?.label ?? ''}</span>
		</div>
		<div class="page-header-content">
			<h1 class="page-title">What I'm up to now</h1>
			<p class="page-lede">
				A <a href="https://nownownow.com/about">/now page</a>: what I'm up to, updated whenever
				something changes.
			</p>
		</div>
		<div class="page-header-aside">
			<QuickFacts
				facts={[
					{ label: 'location', value: 'Bloomington, IN' },
					{ label: 'working on', value: 'Arboretum Lifesciences' }
				]}
			/>
		</div>
	</div>

	<!-- Latest entry -->
	{featured && (
		<div class="section-row">
			<div class="row-label">
				<span class="row-label-text">Latest</span>
			</div>
			<div class="row-content">
				<h2 class="entry-date">{featured.label}</h2>
				<div class="prose" set:html={featured.contentHtml} />
			</div>
		</div>
	)}

	<!-- Older entries -->
	{archive.length > 0 && (
		<div class="section-row">
			<div class="row-label">
				<span class="row-label-text">Earlier</span>
			</div>
			<div class="row-content">
				<ul class="now-timeline">
					{archive.map((entry) => (
						<li class="now-timeline-item">
							<h3 class="tl-date">{entry.label}</h3>
							<div class="prose tl-prose" set:html={entry.contentHtml} />
						</li>
					))}
				</ul>
			</div>
		</div>
	)}
</PageShell>

<style>
	.entry-date {
		font-family: var(--font-display);
		font-weight: 750;
		font-size: 1.6rem;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--fg);
		margin-bottom: 1rem;
	}

	/* Older entries: a dashed line with an open dot per month */
	.now-timeline {
		list-style: none;
		position: relative;
		padding-left: 1.75rem;
	}
	.now-timeline::before {
		content: '';
		position: absolute;
		left: 5px;
		top: 0.6rem;
		bottom: 0.6rem;
		border-left: 1.5px dashed var(--line-strong);
	}
	.now-timeline-item {
		position: relative;
		padding-bottom: 2.25rem;
	}
	.now-timeline-item:last-child {
		padding-bottom: 0;
	}
	.now-timeline-item::before {
		content: '';
		position: absolute;
		left: -1.75rem;
		top: 0.45rem;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		border: 2px solid var(--fg-muted);
		background: var(--bg);
	}
	.tl-date {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.15rem;
		line-height: 1.3;
		color: var(--fg);
		margin-bottom: 0.4rem;
	}
	.tl-prose :global(p) {
		margin-bottom: 0.75rem;
	}
	/* Now entries are mostly a line and a gif; keep images from swamping them */
	.row-content :global(.prose img) {
		max-width: min(100%, 480px);
	}
</style>
