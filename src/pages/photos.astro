---
import PageShell from '../layouts/PageShell.astro';
import { getPhotos } from '#content';

const { photos, collections, lede, annotations } = getPhotos();

const collMap = new Map(collections.map((c) => [c.id, c]));

// Mirrors the .mosaic column counts below: 2 on mobile, 3 under 1100px, 4 under 1400px, 5 above.
const GRID_SIZES =
	'(max-width: 599px) 50vw, (max-width: 1100px) 33vw, (max-width: 1400px) 25vw, 20vw';
---

<PageShell title="Photos · Emma Campbell" description="Photos by Emma Campbell.">
	<div class="page-header-row">
		<div class="page-header-label">
			<span class="phl-val">{photos.length} photos</span>
		</div>
		<div class="page-header-content">
			<h1 class="page-title">Photos</h1>
			{lede && <p class="page-lede">{lede}</p>}
		</div>
		<div class="page-header-aside">
			{annotations.map((note) => (
				<p class="kit-note">{note.body}</p>
			))}
		</div>
	</div>

	<div class="photo-filters" role="group" aria-label="Filter by collection">
		<button class="filter-btn" aria-pressed="true" data-collection="all">
			all <span class="filter-num">{photos.length}</span>
		</button>
		{collections.map((coll) => (
			<button class="filter-btn" aria-pressed="false" data-collection={coll.id}>
				{coll.label} <span class="filter-num">{coll.count}</span>
			</button>
		))}
	</div>

	<div class="mosaic" hidden={photos.length === 0}>
		{photos.map((photo) => (
			<button
				class="photo"
				aria-label={`View ${photo.caption || photo.alt}`}
				data-collection={photo.collection}
				data-caption={photo.caption}
				data-place={photo.place}
				data-date={photo.dateLabel}
				data-exif={photo.exif?.length ? JSON.stringify(photo.exif) : undefined}
			>
				<picture>
					{photo.srcset && photo.srcsetType === 'image/webp' && (
						<source type="image/webp" srcset={photo.srcset} sizes={GRID_SIZES} />
					)}
					<img
						src={photo.src}
						srcset={photo.srcsetType === 'image/jpeg' ? photo.srcset : undefined}
						sizes={photo.srcsetType === 'image/jpeg' ? GRID_SIZES : undefined}
						alt={photo.alt}
						width={photo.width}
						height={photo.height}
						loading="lazy"
						decoding="async"
					/>
				</picture>
				<span class="photo-overlay" aria-hidden="true">
					{photo.caption && <span class="photo-caption">{photo.caption}</span>}
					<span class="photo-meta">
						{photo.place || collMap.get(photo.collection)?.label} · {photo.dateLabel}
					</span>
				</span>
			</button>
		))}
	</div>
	<p class="mosaic-empty" hidden={photos.length > 0}>
		No photos in this collection yet.
	</p>

	<div class="lightbox" slot="after" hidden>
		<div class="lightbox-inner" role="dialog" aria-modal="true">
			<button class="lightbox-close" aria-label="Close photo">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
			<picture>
				<source type="image/webp" />
				<img alt="" decoding="async" />
			</picture>
			<div class="lightbox-caption">
				<p class="lb-title"></p>
				<p class="lb-place"></p>
				<p class="lb-exif"></p>
			</div>
		</div>
	</div>
</PageShell>

<script>
	const filters = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const photos = document.querySelectorAll<HTMLButtonElement>('.photo');
	const mosaic = document.querySelector<HTMLElement>('.mosaic')!;
	const empty = document.querySelector<HTMLElement>('.mosaic-empty')!;

	for (const filter of filters) {
		filter.addEventListener('click', () => {
			const active = filter.dataset.collection;
			for (const f of filters) f.setAttribute('aria-pressed', String(f === filter));
			let shown = 0;
			for (const photo of photos) {
				photo.hidden = active !== 'all' && photo.dataset.collection !== active;
				if (!photo.hidden) shown++;
			}
			mosaic.hidden = shown === 0;
			empty.hidden = shown > 0;
		});
	}

	const lightbox = document.querySelector<HTMLElement>('.lightbox')!;
	const dialog = lightbox.querySelector<HTMLElement>('[role="dialog"]')!;
	const closeButton = lightbox.querySelector<HTMLButtonElement>('.lightbox-close')!;
	const source = lightbox.querySelector('source')!;
	const img = lightbox.querySelector('img')!;
	const title = lightbox.querySelector<HTMLElement>('.lb-title')!;
	const place = lightbox.querySelector<HTMLElement>('.lb-place')!;
	const exif = lightbox.querySelector<HTMLElement>('.lb-exif')!;
	let lastTrigger: HTMLElement | null = null;

	function setAttr(el: Element, name: string, value: string | null | undefined) {
		if (value) el.setAttribute(name, value);
		else el.removeAttribute(name);
	}

	function open(photo: HTMLButtonElement) {
		const gridSource = photo.querySelector('source');
		const gridImg = photo.querySelector('img')!;
		const { caption, date } = photo.dataset;

		// The lightbox shows the same variants as the grid, sized for the whole viewport
		source.hidden = !gridSource;
		setAttr(source, 'srcset', gridSource?.getAttribute('srcset'));
		setAttr(source, 'sizes', gridSource ? '90vw' : null);
		img.src = gridImg.getAttribute('src')!;
		img.alt = gridImg.alt;
		setAttr(img, 'srcset', gridImg.getAttribute('srcset'));
		setAttr(img, 'sizes', gridImg.hasAttribute('srcset') ? '90vw' : null);

		dialog.setAttribute('aria-label', caption || gridImg.alt);
		title.textContent = caption ?? '';
		title.hidden = !caption;
		place.textContent = `${photo.dataset.place} · ${date}`;

		const parts: string[] = photo.dataset.exif ? JSON.parse(photo.dataset.exif) : [];
		exif.hidden = parts.length === 0;
		exif.replaceChildren(
			...parts.flatMap((part, i) => {
				const span = document.createElement('span');
				span.textContent = part;
				if (i === 0) return [span];
				const sep = document.createElement('span');
				sep.className = 'exif-sep';
				sep.setAttribute('aria-hidden', 'true');
				sep.textContent = '·';
				return [sep, span];
			})
		);

		lastTrigger = photo;
		lightbox.hidden = false;
		closeButton.focus();
	}

	function close() {
		lightbox.hidden = true;
		lastTrigger?.focus();
	}

	for (const photo of photos) photo.addEventListener('click', () => open(photo));
	lightbox.addEventListener('click', close);
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !lightbox.hidden) close();
	});
</script>

<style>
	.kit-note {
		font-size: 0.95rem;
		color: var(--fg-muted);
		line-height: 1.5;
	}

	/* Collection filter */
	.photo-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0 0 1.75rem;
	}
	.filter-btn {
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		padding: 0.3rem 0.95rem;
		border-radius: 999px;
		border: 1.5px solid var(--line-strong);
		background: transparent;
		color: var(--fg-muted);
		cursor: pointer;
		transition:
			background-color var(--transition),
			color var(--transition),
			border-color var(--transition);
	}
	.filter-btn:hover {
		color: var(--fg);
		border-color: var(--fg-muted);
	}
	.filter-btn[aria-pressed='true'] {
		background: var(--fg);
		border-color: var(--fg);
		color: var(--bg);
	}
	.filter-num {
		font-weight: 500;
		opacity: 0.75;
		font-variant-numeric: tabular-nums;
		margin-left: 0.15rem;
	}

	/* Mosaic */
	.mosaic {
		column-count: 5;
		column-gap: 14px;
	}
	@media (max-width: 1400px) {
		.mosaic {
			column-count: 4;
		}
	}
	@media (max-width: 1100px) {
		.mosaic {
			column-count: 3;
		}
	}
	.mosaic-empty {
		color: var(--fg-muted);
	}

	.photo {
		break-inside: avoid;
		width: 100%;
		margin-bottom: 14px;
		padding: 0;
		position: relative;
		border-radius: var(--radius-md);
		overflow: hidden;
		border: none;
		cursor: zoom-in;
		display: block;
		background: var(--bg-sunk);
		font: inherit;
		color: inherit;
		text-align: left;
		box-shadow: 1px 3px 8px rgba(20, 24, 50, 0.18);
	}
	.photo picture {
		display: block;
	}
	.photo img {
		width: 100%;
		height: auto;
		display: block;
		transition: transform 0.5s var(--ease-out);
	}
	.photo:hover img {
		transform: scale(1.03);
	}

	/* Caption overlay */
	.photo-overlay {
		position: absolute;
		inset: auto 0 0 0;
		background: linear-gradient(to top, rgba(12, 15, 31, 0.82), rgba(12, 15, 31, 0));
		opacity: 0;
		transition: opacity 0.3s var(--ease-out);
		display: flex;
		flex-direction: column;
		padding: 2.5rem 0.9rem 0.75rem;
		color: #e1e5f7;
	}
	.photo:hover .photo-overlay,
	.photo:focus-visible .photo-overlay {
		opacity: 1;
	}
	.photo-caption {
		font-family: var(--font-display);
		font-weight: 650;
		font-size: 0.98rem;
		line-height: 1.3;
	}
	.photo-meta {
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
		color: rgba(225, 229, 247, 0.85);
	}

	/* Lightbox: always the night ceiling, photos read best on dark */
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 200;
		background: rgba(12, 15, 31, 0.96);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3.5rem 2rem 2rem;
		cursor: zoom-out;
		color: #e1e5f7;
	}
	.lightbox-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		max-width: 100%;
		max-height: 100%;
	}
	.lightbox img {
		display: block;
		max-width: min(90vw, 100%);
		max-height: 78vh;
		width: auto;
		height: auto;
		border-radius: var(--radius-md);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
		cursor: default;
	}
	.lightbox-caption {
		text-align: center;
		cursor: default;
	}
	.lb-title {
		font-family: var(--font-display);
		font-weight: 650;
		font-size: 1.1rem;
	}
	.lb-place,
	.lb-exif {
		font-size: 0.92rem;
		font-variant-numeric: tabular-nums;
		color: rgba(225, 229, 247, 0.78);
	}
	.lb-exif {
		margin-top: 0.15rem;
	}
	/* Built by the lightbox script, so outside this page's scoped markup */
	.lb-exif :global(.exif-sep) {
		margin: 0 0.5em;
		opacity: 0.6;
	}
	.lightbox-close {
		position: fixed;
		top: 1rem;
		right: 1rem;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1.5px solid rgba(225, 229, 247, 0.3);
		background: rgba(225, 229, 247, 0.06);
		color: #e1e5f7;
		cursor: pointer;
		transition: background-color var(--transition);
	}
	.lightbox-close:hover {
		background: rgba(225, 229, 247, 0.16);
	}
	.lightbox-close:focus-visible {
		outline: 2px solid #b9f58c;
		outline-offset: 3px;
	}
	.lightbox-close svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}

	@media (max-width: 599px) {
		.mosaic {
			column-count: 2;
			column-gap: 10px;
		}
		.photo {
			margin-bottom: 10px;
		}
		/* No hover on touch, and two columns leave no room: place and date live in the lightbox */
		.photo-overlay {
			display: none;
		}
		.lightbox {
			padding: 4rem 0.75rem 1rem;
		}
		.lightbox img {
			max-width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.photo img,
		.photo-overlay {
			transition: none;
		}
		.photo:hover img {
			transform: none;
		}
	}
</style>
