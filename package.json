{
  "name": "@spooky/blog-sveltekit",
  "version": "3.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:update-snapshots:linux": "docker run --rm --ipc=host --network host -v $(pwd):/work -v /work/node_modules -w /work -e CI=1 mcr.microsoft.com/playwright:v1.61.0-jammy sh -c 'npm install -g pnpm@10.28.2 && pnpm install --frozen-lockfile && pnpm exec playwright test visual.spec.ts --update-snapshots'"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "mdsvex": "^0.12.8",
    "shiki": "^4.3.1",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "date-fns": "^4.4.0",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.2",
    "luxon": "^3.5.0",
    "marked": "^18.0.9",
    "posthog-js": "^1.391.2",
    "svelte": "^5.56.6",
    "vite": "^8.1.3"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "^7.5.6"
    }
  }
}